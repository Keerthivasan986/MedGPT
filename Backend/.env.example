NODE_ENV=development
PORT=4000

# Local:  mongodb://127.0.0.1:27017/medgpt
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medgpt?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medgpt?retryWrites=true&w=majority

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=10
RESERVATION_WINDOW_HOURS=4
DEFAULT_RADIUS_KM=5
